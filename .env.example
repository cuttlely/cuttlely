# Copy to .env if you want to override the defaults in docker-compose.yml.
# docker compose up -d works without this file. Do not commit .env.
#
# The image. Unset means ghcr.io/cuttlely/cuttlely:latest, and Compose builds this checkout when it
# cannot pull that. Pin a release, or give your own build a name:
# CUTTLELY_IMAGE=ghcr.io/cuttlely/cuttlely:1.4.9

# Build argument for a local image. 1 (the default) installs Chromium. 0 leaves it out.
# Puppeteer and Playwright document loaders then fail with "this image has no browser".
# INCLUDE_BROWSER=0

# Build argument for a local image. 1 (the default) keeps optional node packs. 0 leaves them out.
# INCLUDE_NODE_PACKS=0

# Build argument for a local image. false (the default) keeps the IP geolocation database.
# true leaves it out. Audit events then have no country and no region.
# CUTTLELY_OMIT_GEOIP=true

# Published URL is http://localhost:43117
# PORT=43117

# Password form on /signin for one local account. On by default in Docker (blank counts as unset), so a
# fresh install can create its first account from the setup link in docker compose logs cuttlely. Set false,
# then recreate the container, when you use WorkOS or publish the port beyond your machine.
# CUTTLELY_LOCAL_ADMIN=false

# Analyst mode. auto creates analyst.db beside the app database. Docs: docs/how-to/analyst.md
# CUTTLELY_ANALYST=auto

# Query previews on the run card. Unset is on. false leaves row values out of new run traces.
# The row count can still show. Docs: docs/how-to/analyst.md
# CUTTLELY_ANALYST_TRACE_PREVIEW=true

# Optional node packs. The packs that ship with the install always load.
# This variable adds more, comma-separated. A blank value adds nothing and removes nothing.
# INCLUDE_NODE_PACKS=0 skips the shipped packs. Docs: docs/how-to/node-packs.md
# CUTTLELY_NODE_PACKS=

# Version history is on. Set off (or false, 0, no), then recreate the container, to turn it off.
# Docs: docs/reference/versioning-settings.md
# CUTTLELY_VERSIONS=off

# Drafts are on: chatflow and agentflow canvases save to a draft until you Publish.
# Set off (or false, 0, no), then recreate the container, to save straight to Live.
# Docs: docs/reference/versioning-settings.md
# CUTTLELY_DRAFTS=off

# Credential encryption. Leave unset and the first boot writes encryption.key on the volume.
# Losing that file, or this value, makes stored credentials unreadable.
# Generate with: openssl rand -hex 32
# FLOWISE_SECRETKEY_OVERWRITE=
# CUTTLELY_SECRETKEY_OVERWRITE is the same key. If both are set and the values differ, Cuttlely refuses to start.
# CUTTLELY_SECRETKEY_OVERWRITE=
# CUTTLELY_FILE_SIZE_LIMIT=50mb
# DISABLE_CUTTLELY_TELEMETRY=true
# METRICS_PREFIX=

# Run traces are off. Compose passes these from .env into the container. Inside the
# container, localhost is the container, not a collector on the host.
# Docs: docs/how-to/docker.md and docs/how-to/observability.md
# CUTTLELY_OTEL_TRACES=true
# CUTTLELY_OTEL_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
# CUTTLELY_OTEL_TRACES_PROTOCOL=http
# CUTTLELY_OTEL_TRACES_CONTENT=false
# CUTTLELY_OTEL_TRACES_CONTENT_MAX=4000 # 0 is no limit: full question and answer text goes to the collector

# Direct Docker publish is not behind a proxy. Set the hop count only when nginx or
# another load balancer sits in front. Blank trusts no proxies. render.yaml uses 1.
# TRUST_PROXY=

# Generic OIDC uses this public origin for its callback. Use HTTPS except for local development.
# APP_URL=https://cuttlely.example.com
# CUTTLELY_OIDC_CLIENT_SECRET=

# AuthKit is optional. Leave these unset for the single Super User above.
# Setup: docs/identity/workos-authkit-setup.md
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_REDIRECT_URI=http://localhost:43117/api/v1/auth/callback
# WORKOS_COOKIE_PASSWORD=
# CUTTLELY_BOOTSTRAP_EMAIL=

# Default IANA timezone for the Current Date Time tool when the node's Timezone field is empty.
# A per-call timezone overrides both. Unset keeps the tool's previous output.
# The host sets this. Server settings does not edit it.
# Docs: docs/reference/current-date-time.md
# CUTTLELY_DEFAULT_TIMEZONE=America/Chicago
