            "types": "./dist/src/agents.d.ts",
            "default": "./dist/src/agents.js"
        },
        "./storageUtils": {
            "types": "./dist/src/storageUtils.d.ts",
            "default": "./dist/src/storageUtils.js"
        },
        "./modelLoader": {
            "types": "./dist/src/modelLoader.d.ts",
