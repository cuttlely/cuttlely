{
    "compilerOptions": {
        "lib": ["ES2020", "ES2021.String", "ES2022.Array"],
        "experimentalDecorators": true /* Enable experimental support for TC39 stage 2 draft decorators. */,
        "emitDecoratorMetadata": true /* Emit design-type metadata for decorated declarations in source files. */,
        "target": "ES2020", // or higher
        "outDir": "./dist/",
        "baseUrl": ".",
        "paths": {
            "@cuttlely/components": ["src/index.ts"],
            "@cuttlely/components/interface": ["src/Interface.ts"],
            "@cuttlely/components/utils": ["src/utils.ts"],
            "@cuttlely/components/indexing": ["src/indexing.ts"],
            "@cuttlely/components/validator": ["src/validator.ts"],
            "@cuttlely/components/sanitizeDataSourceOptions": ["src/sanitizeDataSourceOptions.ts"],
            "@cuttlely/components/awsToolsUtils": ["src/awsToolsUtils.ts"],
            "@cuttlely/components/agents": ["src/agents.ts"],
            "@cuttlely/components/storageUtils": ["src/storageUtils.ts"],
            "@cuttlely/components/nodes": ["nodes/index.ts"],
            "@cuttlely/components/modelLoader": ["src/modelLoader.ts"],
            "@cuttlely/components/etl-engine": ["nodes/etl/engine.ts"],
            "@cuttlely/components/handler": ["src/handler.ts"],
            "@cuttlely/components/google-utils": ["src/google-utils.ts"],
            "@cuttlely/components/openApiSpec": ["src/openApiSpec.ts"],
            "@cuttlely/components/httpSecurity": ["src/httpSecurity.ts"],
            "@cuttlely/components/moderation": ["nodes/moderation/Moderation.ts"],
            "@cuttlely/components/outputParserHelpers": ["nodes/outputparsers/OutputParserHelpers.ts"]
        },
        "resolveJsonModule": true,
        "esModuleInterop": true /* Emit additional JavaScript to ease support for importing CommonJS modules. This enables `allowSyntheticDefaultImports` for type compatibility. */,
        "forceConsistentCasingInFileNames": true /* Ensure that casing is correct in imports. */,
        "strict": true /* Enable all strict type-checking options. */,
        "skipLibCheck": true /* Skip type checking all .d.ts files. */,
        "sourceMap": true,
        "strictPropertyInitialization": false,
        "useUnknownInCatchVariables": false,
        "declaration": true,
        "module": "commonjs"
    },
    "include": ["src", "nodes", "credentials"],
    "exclude": ["gulpfile.ts", "node_modules", "dist", "**/*.test.ts", "**/*.test.js", "**/*.spec.ts", "**/*.spec.js"]
}
