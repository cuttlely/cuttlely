{
    "name": "@cuttlely/server",
    "version": "1.3.1",
    "private": true,
    "description": "Cuttlely server",
    "main": "dist/index",
    "types": "dist/index.d.ts",
    "bin": {
        "flowise": "./bin/run",
        "cuttlely-server": "./bin/run"
    },
    "files": [
        "bin",
        "marketplaces",
        "dist",
        "npm-shrinkwrap.json",
        "oclif.manifest.json",
        "oauth2.html"
    ],
    "oclif": {
        "bin": "flowise",
        "binAliases": [
            "cuttlely-server"
        ],
        "dirname": "flowise",
        "commands": "./dist/commands"
    },
    "scripts": {
        "build": "tsc && rimraf dist/enterprise dist/IdentityManager.js dist/IdentityManager.d.ts dist/IdentityManager.js.map dist/IdentityManager.d.ts.map dist/StripeManager.js dist/StripeManager.d.ts dist/StripeManager.js.map dist/StripeManager.d.ts.map && node ../../scripts/build-node-pack-index.mjs --check && node -e \"const fs=require('fs'); fs.mkdirSync('dist/utils',{recursive:true}); fs.copyFileSync('src/utils/node-pack-index.json','dist/utils/node-pack-index.json')\" && node ../../scripts/copy-ui-build.mjs",
        "start": "run-script-os",
        "clean": "rimraf dist",
        "nuke": "pnpm clean && rimraf node_modules .turbo",
        "start:windows": "cd bin && run start",
        "start:default": "cd bin && ./run start",
        "start-worker:windows": "cd bin && run worker",
        "start-worker:default": "cd bin && ./run worker",
        "user": "run-script-os",
        "user:windows": "cd bin && run user",
        "user:default": "cd bin && ./run user",
        "settings": "run-script-os",
        "settings:windows": "cd bin && run settings",
        "settings:default": "cd bin && ./run settings",
        "dev": "nodemon",
        "oclif-dev": "run-script-os",
        "oclif-dev:windows": "cd bin && dev start",
        "oclif-dev:default": "cd bin && ./dev start",
        "prepack": "pnpm build",
        "typeorm": "typeorm-ts-node-commonjs",
        "typeorm:migration-generate": "pnpm typeorm migration:generate -d ./src/utils/typeormDataSource.ts",
        "typeorm:migration-run": "pnpm typeorm migration:run -d ./src/utils/typeormDataSource.ts",
        "typeorm:migration-revert": "pnpm typeorm migration:revert -d ./src/utils/typeormDataSource.ts",
        "watch": "tsc --watch",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run",
        "e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
        "cypress:ci": "START_SERVER_AND_TEST_INSECURE=1 start-server-and-test start https-get://localhost:3000 cypress:run",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [],
    "homepage": "https://github.com/cuttlely/cuttlely",
    "author": {
        "name": "Henry Heng",
        "email": "henryheng@flowiseai.com"
    },
    "engines": {
        "node": "^24"
    },
    "license": "SEE LICENSE IN LICENSE.md",
    "overrides": {
        "prebuild-install": "7.1.3",
        "axios": "1.20.0",
        "body-parser": "2.0.2",
        "braces": "3.0.3",
        "cross-spawn": "7.0.6",
        "form-data": "4.0.4",
        "glob-parent": "6.0.2",
        "http-proxy-middleware": "3.0.3",
        "json5": "2.2.3",
        "nth-check": "2.1.1",
        "path-to-regexp": "0.1.12",
        "prismjs": "1.29.0",
        "rollup": "4.45.0",
        "semver": "7.7.1",
        "set-value": "4.1.0",
        "solid-js": "1.9.11",
        "protobufjs": ">=7.5.5",
        "tar-fs": "3.1.1",
        "unset-value": "2.0.1",
        "webpack-dev-middleware": "7.4.2",
        "ws": "8.22.0",
        "xlsx": "0.18.5",
        "uuid": "^11.1.1",
        "@tootallnate/once": ">=3.0.1",
        "tmp": ">=0.2.4",
        "@elastic/transport": ">=8.9.3",
        "multer": "2.4.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1014.0",
        "@aws-sdk/client-secrets-manager": "^3.1014.0",
        "@azure/storage-blob": "^12.29.0",
        "@bull-board/api": "^6.11.0",
        "@bull-board/express": "^6.11.0",
        "@cuttlely/chat": "workspace:^",
        "@cuttlely/components": "workspace:^",
        "@cuttlely/node-pack-caches-memory": "workspace:*",
        "@cuttlely/node-pack-tools-mcp": "workspace:*",
        "@cuttlely/node-pack-vector-stores": "workspace:*",
        "@cuttlely/node-pack-legacy-chains": "workspace:*",
        "@google-cloud/logging-winston": "^6.0.0",
        "@google-cloud/storage": "^7.22.0",
        "@keyv/redis": "^4.2.0",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@oclif/core": "4.0.7",
        "@opentelemetry/api": "1.9.0",
        "@opentelemetry/context-async-hooks": "1.27.0",
        "@opentelemetry/exporter-metrics-otlp-grpc": "0.54.0",
        "@opentelemetry/exporter-metrics-otlp-http": "0.54.0",
        "@opentelemetry/exporter-metrics-otlp-proto": "0.54.0",
        "@opentelemetry/resources": "1.27.0",
        "@opentelemetry/exporter-trace-otlp-grpc": "0.54.0",
        "@opentelemetry/exporter-trace-otlp-http": "0.54.0",
        "@opentelemetry/exporter-trace-otlp-proto": "0.54.0",
        "@opentelemetry/sdk-metrics": "1.27.0",
        "@opentelemetry/sdk-trace-base": "1.27.0",
        "@opentelemetry/sdk-trace-node": "1.27.0",
        "@opentelemetry/semantic-conventions": "1.27.0",
        "@workos-inc/node": "11.0.0",
        "async-mutex": "^0.4.0",
        "axios": "1.20.0",
        "bullmq": "5.45.2",
        "cache-manager": "^6.3.2",
        "content-disposition": "0.5.4",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "crypto-js": "^4.1.1",
        "csv-parser": "^3.0.0",
        "dotenv": "^16.0.0",
        "express": "^4.17.3",
        "express-rate-limit": "^6.9.0",
        "@cuttlely/versioning": "workspace:*",
        "flowise-nim-container-manager": "^1.0.11",
        "geoip-lite": "^2.0.3",
        "global-agent": "^3.0.0",
        "http-status-codes": "^2.3.0",
        "langchainhub": "^0.0.11",
        "lodash": "^4.17.21",
        "multer": "2.4.0",
        "multer-cloud-storage": "^4.0.0",
        "multer-s3": "^3.0.1",
        "mysql2": "^3.11.3",
        "node-cron": "^4.2.1",
        "openai": "6.19.0",
        "pg": "^8.11.1",
        "posthog-node": "^3.5.0",
        "prom-client": "^15.1.3",
        "rate-limit-redis": "^4.2.0",
        "reflect-metadata": "^0.1.13",
        "s3-streamlogger": "^1.11.0",
        "sanitize-html": "^2.18.1",
        "sqlite3": "6.0.1",
        "bcryptjs": "3.0.3",
        "turndown": "^7.2.0",
        "typeorm": "^0.3.31",
        "uuid": "^11.1.1",
        "winston": "^3.9.0",
        "winston-azure-blob": "^1.5.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^3.25.76 || ^4"
    },
    "devDependencies": {
        "@a2a-js/sdk": "0.3.14",
        "@cuttlely/ui": "workspace:^",
        "@types/content-disposition": "0.5.8",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.12",
        "@types/crypto-js": "^4.1.1",
        "@types/geoip-lite": "^1.4.4",
        "@types/jest": "^29.5.14",
        "@types/lodash": "^4.17.20",
        "@types/multer": "^1.4.7",
        "@types/multer-s3": "^3.0.3",
        "@types/sanitize-html": "^2.9.5",
        "@types/supertest": "^6.0.3",
        "@types/turndown": "^5.0.5",
        "ajv": "8.17.1",
        "concurrently": "^7.1.0",
        "cypress": "^13.13.0",
        "jest": "^29.7.0",
        "nodemon": "^2.0.22",
        "rimraf": "^5.0.5",
        "run-script-os": "^1.1.6",
        "shx": "^0.3.3",
        "start-server-and-test": "^2.0.3",
        "supertest": "^7.1.0",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.7.0",
        "tsc-watch": "^6.0.4",
        "typescript": "^5.4.5"
    }
}
