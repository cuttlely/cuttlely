-    "js-yaml@^4": "4.3.1",
+    "js-yaml@^4": "4.3.2",
     "undici@^6": "6.28.0",
     "undici@^7": "7.29.0",
     "postcss": "8.5.23",
@@ -76,7 +76,7 @@
