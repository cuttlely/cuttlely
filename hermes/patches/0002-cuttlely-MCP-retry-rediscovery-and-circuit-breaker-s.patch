+def _cuttlely_schedule(coro) -> None:
+    """Run a Cuttlely retry on the MCP loop. Discovery is already on that loop."""
+    try:
+        asyncio.get_running_loop().create_task(coro)
+    except RuntimeError:
+        coro.close()
+
+
+async def _cuttlely_retry_empty_tools(name: str, server) -> None:
+    """cuttlely: re-list tools until one appears or the short backoff runs out."""
+    from tools.mcp_tool_cuttlely import CUTTLELY_TOOL_RETRY_DELAYS, cuttlely_retry_tool_list
+
+    async def list_once():
+        if getattr(server, "_tools", None):
+            return list(server._tools)
+        try:
+            await server._discover_tools()
+        except Exception as exc:
+            logger.info("cuttlely: MCP '%s' tools/list retry failed: %s", name, exc)
+            return []
+        return list(getattr(server, "_tools", None) or [])
+
+    tools = await cuttlely_retry_tool_list(list_once, delays=CUTTLELY_TOOL_RETRY_DELAYS)
+    if tools:
+        logger.info("cuttlely: MCP server '%s' registered %d tool(s) after an empty tools/list", name, len(tools))
+    else:
+        logger.warning("cuttlely: MCP server '%s' still has no tools after startup retries", name)
+
+
+async def _cuttlely_retry_connect(name: str, config: dict) -> None:
+    """cuttlely: reconnect a server that failed at startup, a few times, then stop."""
+    from tools.mcp_tool_cuttlely import CUTTLELY_TOOL_RETRY_DELAYS
+
+    for delay in CUTTLELY_TOOL_RETRY_DELAYS:
+        await asyncio.sleep(delay)
+        with _core._lock:
+            key = _server_key(name)
+            live = _core._servers.get(key)
+            # A live session owns its own empty-list retry. Do not spawn a second process.
+            if live is not None and getattr(live, "session", None) is not None:
+                return
+            _core._server_connect_retry_after.pop(key, None)
+            _core._server_connecting.discard(key)
+        try:
+            names = await _discover_and_register_server(name, config)
+        except BaseException as exc:
+            logger.info("cuttlely: MCP '%s' connect retry failed: %s", name, exc)
+            continue
+        _note_connect_success(name)
+        logger.info("cuttlely: MCP server '%s' connected on retry with %d tool(s)", name, len(names or []))
+        return
+    logger.warning("cuttlely: MCP server '%s' was still unreachable after startup retries", name)
+
+
 async def _discover_and_register_server(name: str, config: dict) -> List[str]:
     """Connect one server, register its tools; return the registered names."""
     # The claim fires inside _connect_server while this frame is suspended (list, not nonlocal).
@@ -338,6 +392,9 @@ async def _discover_and_register_server(name: str, config: dict) -> List[str]:
