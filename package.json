{
    "name": "cuttlely-workspace",
    "version": "1.3.1",
    "private": true,
    "license": "Apache-2.0",
    "description": "The open-source agent platform for applications.",
    "homepage": "https://github.com/cuttlely/cuttlely",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
        "build:docker": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=./packages/chat-widget --filter=./packages/components --filter=./packages/node-pack-vector-stores --filter=./packages/node-pack-tools-mcp --filter=./packages/node-pack-caches-memory --filter=./packages/node-pack-legacy-chains --filter=./packages/server --filter=./packages/ui --filter=./packages/api-documentation",
        "build-force": "pnpm clean && TURBO_TELEMETRY_DISABLED=1 turbo run build --force",
        "dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --parallel --no-cache",
        "start": "run-script-os",
        "start:harness": "bash scripts/start-cuttlely.sh",
        "harness:check": "node packages/harness/check.mjs",
        "verify": "node scripts/verify.mjs",
        "release": "node scripts/release.mjs",
        "upgrade:check": "node scripts/upgrade-check.mjs",
        "safeboot:check": "node scripts/safeboot-check.mjs",
        "verify:comment": "node scripts/verify-comment.mjs",
        "etl:check": "node packages/etl/check.mjs",
        "templates:gallery": "node scripts/live-e2e/template-gallery.mjs",
        "check:clean-export": "node scripts/check-clean-export.mjs",
        "start:windows": "cd packages/server/bin && run start",
        "start:default": "cd packages/server/bin && ./run start",
        "start-worker": "run-script-os",
        "start-worker:windows": "cd packages/server/bin && run worker",
        "start-worker:default": "cd packages/server/bin && ./run worker",
        "user": "run-script-os",
        "user:windows": "cd packages/server/bin && run user",
        "user:default": "cd packages/server/bin && ./run user",
        "settings": "run-script-os",
        "settings:windows": "cd packages/server/bin && run settings",
        "settings:default": "cd packages/server/bin && ./run settings",
        "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
        "test:coverage": "TURBO_TELEMETRY_DISABLED=1 turbo run test:coverage",
        "test:queue-abort": "node scripts/queue-abort-e2e.mjs",
        "clean": "pnpm -r clean",
        "nuke": "pnpm -r nuke && rimraf node_modules .turbo",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "hermes:vendor": "node scripts/vendor-hermes.mjs",
        "lint": "eslint \"**/*.{js,jsx,ts,tsx,json,md}\" --ignore-pattern \"hermes/**\"",
        "lint-fix": "pnpm lint --fix",
        "quick": "pretty-quick --staged",
        "postinstall": "husky install",
        "migration:create": "pnpm typeorm migration:create",
        "changeset": "changeset",
        "changeset:version": "changeset version"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,md}": "eslint --fix"
    },
    "dependencies": {
        "flowise-components": "workspace:@cuttlely/components@*",
        "run-script-os": "^1.1.6"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.0",
        "@babel/preset-env": "^7.19.4",
        "@babel/preset-typescript": "7.18.6",
        "@types/express": "^4.17.13",
        "@typescript-eslint/typescript-estree": "^7.13.1",
        "eslint": "^8.24.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-markdown": "^3.0.0",
        "eslint-plugin-prettier": "^3.4.0",
        "eslint-plugin-react": "^7.26.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-unused-imports": "^2.0.0",
        "husky": "^8.0.1",
        "kill-port": "2.0.1",
        "lint-staged": "^13.0.3",
        "prettier": "^2.7.1",
        "pretty-quick": "^3.1.3",
        "rimraf": "^3.0.2",
        "turbo": "2.11.7",
        "typescript": "^5.4.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "faiss-node",
            "sqlite3"
        ],
        "overrides": {
            "prebuild-install": "7.1.3",
            "axios": "1.20.0",
            "follow-redirects": "1.16.1",
            "body-parser": "2.3.0",
            "braces": "3.0.3",
            "cross-spawn": "7.0.6",
            "form-data": "4.0.6",
            "glob-parent": "6.0.2",
            "json5": "2.2.3",
            "nth-check": "2.1.1",
            "path-to-regexp": "0.1.13",
            "prismjs": "^1.30.0",
            "rollup": "4.59.0",
            "semver": "7.7.1",
            "set-value": "4.1.0",
            "solid-js": "1.9.11",
            "protobufjs": "^8.6.6",
            "tar-fs": "3.1.1",
            "unset-value": "2.0.1",
            "ws": "8.22.0",
            "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
            "uuid": "^11.1.1",
            "@tootallnate/once": ">=3.0.1",
            "tmp": ">=0.2.4",
            "@elastic/transport": ">=8.9.3",
            "@modelcontextprotocol/sdk": "^1.32.1",
            "multer": "2.4.0",
            "@qdrant/js-client-rest": "1.18.0",
            "undici@6": "6.29.0",
            "undici@7": "7.30.0",
            "handlebars": "4.7.10",
            "tar": "^7.5.22",
            "sqlite3": "6.0.1",
            "basic-ftp": "^6.2.3",
            "convict": "^6.2.5",
            "fast-xml-builder": "^1.1.7",
            "proxy-addr": "^2.0.8",
            "@mem0/community>@langchain/community": "1.1.12",
            "@xmldom/xmldom@0.8": "^0.8.14",
            "brace-expansion@1": "^1.1.20",
            "brace-expansion@2": "^2.1.6",
            "browserslist": "^4.28.7",
            "fast-uri": "^3.1.7",
            "hono": "^4.12.25",
            "ip-address@10": "^10.3.1",
            "jws@3": "^3.2.3",
            "jws@4": "^4.0.1",
            "linkify-it@5": "^5.0.2",
            "lodash": "^4.18.1",
            "lodash-es": "^4.18.1",
            "mysql2": "^3.22.0",
            "nanoid@3": "^3.3.18",
            "picomatch@2": "^2.3.2",
            "picomatch@4": "^4.0.4",
            "postcss@8": "^8.5.18",
            "prosemirror-view": "^1.42.3",
            "source-map-js": "^1.2.2",
            "underscore": "^1.13.8",
            "validator": "^13.15.22",
            "shell-quote": "^1.9.0",
            "flatted": "^3.4.2",
            "glob@10": "^10.5.0",
            "immutable@4": "^4.3.9",
            "joi@17": "^17.13.7",
            "js-yaml@3": "^3.15.2",
            "minimatch@3": "^3.1.4",
            "socks": "^2.8.10",
            "playwright": "1.64.0",
            "@playwright/test": "1.64.0",
            "langsmith": "^0.6.3",
            "adm-zip": "^0.6.1",
            "@babel/plugin-transform-modules-systemjs": "^7.29.4",
            "serialize-javascript": "^7.0.3",
            "@opentelemetry/propagator-jaeger": "^2.9.0",
            "jsondiffpatch": "^0.7.6",
            "fast-xml-parser": "^5.7.3",
            "express@4": "^4.22.3",
            "cookie@<0.7.0": "^0.7.2",
            "cookie-parser": "^1.4.7",
            "@babel/runtime@7": "^7.26.10",
            "@hono/node-server@1": "^1.19.15",
            "on-headers": "^1.1.0",
            "qs": "^6.16.0",
            "yauzl@3": "^3.4.0",
            "diff@4": "^4.0.4",
            "diff@5": "^5.2.2",
            "yaml@1": "^1.10.3",
            "yaml@2": "^2.8.3",
            "swagger-jsdoc>yaml": "^2.8.3",
            "mdast-util-to-hast@13": "^13.2.1",
            "katex": "^0.18.2",
            "@ai-sdk/provider-utils@4": "^4.0.33",
            "micromatch": "^4.0.8",
            "@langchain/aws>@aws-sdk/client-bedrock-agent-runtime": "^3.1065.0",
            "@langchain/community>@browserbasehq/stagehand": "-",
            "mem0ai>@types/jest": "-",
            "unctx>unplugin": "-",
            "@babel/core": "7.29.7",
            "@babel/helpers": "7.29.7",
            "ibm-cloud-sdk-core@5": "^5.9.0",
            "ajv@>=7 <8.18.0": "8.18.0"
        }
    },
    "packageManager": "pnpm@10.33.4",
    "engines": {
        "node": "^24",
        "pnpm": "^10.26.0"
    },
    "resolutions": {
        "@anthropic-ai/sdk": "^0.73.0",
        "@google/generative-ai": "^0.24.0",
        "@grpc/grpc-js": "^1.13.6",
        "@langchain/core": "1.1.20",
        "@qdrant/openapi-typescript-fetch": "1.2.6",
        "openai": "6.19.0",
        "protobufjs": "^8.6.6",
        "uuid": "^11.1.1"
    },
    "eslintIgnore": [
        "**/dist",
        "**/node_modules",
        "**/build",
        "**/package-lock.json",
        "hermes/**"
    ],
    "prettier": {
        "printWidth": 140,
        "singleQuote": true,
        "jsxSingleQuote": true,
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "endOfLine": "auto"
    },
    "babel": {
        "presets": [
            "@babel/preset-typescript",
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                }
            ]
        ]
    }
}
