---
// The import guide at /flowise/import-guide/, linked from /flowise/. The body is src/guides/flowise-import/guide.md.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { Content, getHeadings } from '../../guides/flowise-import/guide.md'

const title = 'How to import a Flowise export into Cuttlely'
// The guide was first published on DEV, so search engines get that copy as the canonical one.
const canonical = 'https://dev.to/cuttlely/how-to-import-a-flowise-export-into-cuttlely-5c8j'
---

<StarlightPage frontmatter={{ title, pagefind: true, head: [{ tag: 'link', attrs: { rel: 'canonical', href: canonical } }] }} headings={getHeadings()} hasSidebar={false}>
    <h1 id="_top">{title}</h1>
    <Content />
</StarlightPage>
