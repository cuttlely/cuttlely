---
// The cuttlely.com home page. Every claim here comes from the README, the docs or SECURITY.md.
import path from 'node:path'
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { Code, Icon } from '@astrojs/starlight/components'
import { Image } from 'astro:assets'
import ZoomableImage from '../components/ZoomableImage.astro'
import laptop from '../assets/cuttlely-mascot-laptop-512.webp'
import careAnswer from '../content/docs/docs/images/try-the-demo/customer-care-answer.png'
import analystChat from '../content/docs/docs/images/harnesses/canvas-chat-analyst.png'
import publishCheck from '../content/docs/docs/images/versioning/publish-check-results.png'
import serverSettings from '../content/docs/docs/images/server-settings/server-settings-all.png'
import Focus from '../components/Focus.astro'
import { mediaUrl as versionedMedia } from '../../scripts/media-version.mjs'
import { REPO_URL } from '../../scripts/site-config.mjs'

// Resolved when the page renders. import.meta.url is the bundled chunk by then, so the site root is the build's cwd.
const publicDir = path.resolve(process.cwd(), 'public')
const mediaUrl = (urlPath: string) => versionedMedia(urlPath, publicDir)

const curl = `curl -s http://localhost:43117/api/v1/prediction/<chatflow-id> \\
  -H "Authorization: Bearer $CUTTLELY_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"question": "How much are two croissants and a sourdough loaf, and can I pick them up on Monday?"}' \\
  | jq '{text, agents: [.agents[] | {name, task}]}'`

const answer = `{
    "text": "Two croissants and a sourdough loaf cost $14.00. However, you cannot pick them up on Monday because the bakery is closed; pick up is possible Tuesday to Sunday from 7:00 to 15:00.",
    "agents": [
        { "name": "baker", "task": "How much are two croissants and a sourdough loaf?" },
        { "name": "orders", "task": "Can I pick up two croissants and a sourdough loaf on Monday?" }
    ]
}`

type ToolVideo = { slug: string; length: string; label: string }
const tools: { title: string; text: string; href: string; video: ToolVideo }[] = [
    {
        title: 'Knowledge pipelines',
        text: 'Load files, a CSV or a code repository, clean and split them, embed them and store them for search. A run only embeds what changed.',
        href: '/docs/how-to/etl/',
        video: {
            slug: 'knowledge-pipelines',
            length: '0:35',
            label: 'A knowledge pipeline on a real Cuttlely server: the first run embeds 33 products and goes from the click to indexed in under a second, with no provider keys and embeddings that ran locally.'
        }
    },
    {
        title: 'Chatflows',
        text: 'A chat model, the agent or chain that answers, memory and tools, on one canvas. Each chatflow gets a prediction API, an embed and a shareable link.',
        href: '/docs/how-to/canvas/',
        video: {
            slug: 'chatflows',
            length: '0:35',
            label: 'A bakery chatflow on a real Cuttlely server: median of 20 runs, 1.1 seconds to first words after two model calls and the calculator, 1.3 seconds to the full answer on the first question, and 1.3 seconds for the follow-up answer, with the order kept.'
        }
    },
    {
        title: 'Agentflows',
        text: 'Workflows that run step by step and can start from a chat message, a form, a webhook or a schedule.',
        href: '/docs/how-to/canvas/#workflows',
        video: {
            slug: 'agentflows',
            length: '0:30',
            label: 'A bakery order desk workflow on a real Cuttlely server: median of 20 runs of an equivalent flow with the same branches and questions, not the recorded canvas, 0.9 seconds to first words on the care branch after classifying the message, 1.2 seconds to the full care answer, and 0.8 seconds to first words on the order branch.'
        }
    },
    {
        title: 'Harnesses: Agent Teams',
        text: 'Harness Prime reads each message and sends the work to specialists, each with its own instructions and tools, like the Analyst with its own database. Every specialist gets a task that stands on its own, and the run card shows the tokens each one used.',
        href: '/docs/how-to/harnesses/',
        video: {
            slug: 'harnesses',
            length: '0:48',
            label: 'A bakery agent team on a real Cuttlely server: the run finishes in 4.2 seconds, routing takes 855 milliseconds, and at turn 92 the analyst\'s prompt is 3.7 times smaller than a single chatbot\'s, 2,114 versus 7,719 tokens, the first model call of each turn.'
        }
    },
    {
        title: 'Build with AI',
        text: 'Describe a team, an assistant, a pipeline or a workflow, and a first version lands on the canvas. Every part and connection is checked first.',
        href: '/docs/how-to/harnesses/#build-a-team-with-ai',
        video: {
            slug: 'build-with-ai',
            length: '0:31',
            label: 'Build with AI on a real Cuttlely server: a bakery team is described in plain words, built and saved in 5.3 seconds, and its first starter question finishes in 4.0 seconds with both specialists, the menu expert in 701 milliseconds.'
        }
    },
    {
        title: 'Share and embed',
        text: 'A public link for any chatflow, and a chat button or full-page chat on your website, served by your Cuttlely server.',
        href: '/docs/how-to/share-and-embed/',
        video: {
            slug: 'share-and-embed',
            length: '0:27',
            label: 'Share and embed on a real Cuttlely server: median of 20 runs, 0.4 seconds to first words on the shared link, 0.8 seconds to the full table, and 0.4 seconds to first words in the embed widget.'
        }
    }
]

const installs = [
    { title: 'Docker', text: 'The install most people want. SQLite, one container.', href: '/docs/how-to/docker/', icon: 'laptop' },
    { title: 'Render', text: 'A hosted install with Postgres, from the Blueprint in the repository.', href: '/docs/how-to/render/', icon: 'rocket' },
    { title: 'From source', text: 'For changing Cuttlely. Node 24 and pnpm.', href: '/docs/how-to/from-source/', icon: 'seti:git' }
] as const
---

<StarlightPage
    frontmatter={{
        title: 'Your applications deserve agents.',
        description:
            'Cuttlely is the open-source agent platform for applications. Give your applications their own intelligent capabilities and coordinated agent teams, and run it on infrastructure you control.',
        template: 'splash',
        hero: { tagline: 'The open-source agent platform for applications.', actions: [] },
        pagefind: false,
        tableOfContents: false
    }}
    hasSidebar={false}
>
    <div class="cl-home not-content">
        <ul class="cl-proof" aria-label="At a glance">
            <li><Icon name="open-book" /> Open source under Apache 2.0</li>
            <li><Icon name="laptop" /> Docker, Render or from source</li>
            <li><Icon name="rocket" /> The demo shows a team at work in about a minute</li>
        </ul>

        <section id="chat-with-a-team-in-minutes" class="cl-showcase" aria-labelledby="cl-showcase-title">
            <figure class="cl-demo-window">
                <div class="cl-video-stage">
                    <video
                        class="cl-demo-video"
                        data-demo-video
                        controls
                        muted
                        loop
                        playsinline
                        preload="none"
                        width="1280"
                        height="720"
                        poster={mediaUrl('/media/customer-care-demo-poster.webp')}
                        aria-describedby="cl-demo-caption"
                    >
                        <source src={mediaUrl('/media/customer-care-demo.webm')} type="video/webm" />
                        <source src={mediaUrl('/media/customer-care-demo.mp4')} type="video/mp4" />
                    </video>
                    <button type="button" class="cl-play-overlay" data-play-with-sound aria-label="Play the demo with sound">
                        <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true">
                            <path d="M8 5v14l12-7z" fill="currentColor" />
                        </svg>
                    </button>
                </div>
                <figcaption id="cl-demo-caption" class="cl-demo-caption">
                    A narrated walkthrough of one real run, with captions. The live part plays in real time: this run's plan starts streaming at 0.8 seconds,
                    the team is routed at 1.9 seconds, and the full answer lands at 19.8 seconds. Across five runs the median is 16.5 seconds.
                </figcaption>
            </figure>
            <div class="cl-showcase-copy">
                <p class="cl-kicker">Try the demo</p>
                <h2 id="cl-showcase-title" class="cl-display">Watch a team resolve a complaint</h2>
                <p>
                    Add one model key and select <strong>Try the demo</strong>. A customer writes in about a late espresso machine. A customer specialist reads
                    the account, an operations specialist traces the parcel, and a policy specialist checks the written policy, each with its own data and tools.
                    Harness Prime writes the decision, the reply and the actions, with the evidence. All the data is made up.
                </p>
                <a class="cl-link-arrow" href="/docs/how-to/try-the-demo/">Try the demo <Icon name="right-arrow" /></a>
            </div>
        </section>

        <section id="one-complaint-three-specialists" class="cl-section cl-case" aria-labelledby="case-title">
            <div class="cl-center">
                <p class="cl-kicker">One real run</p>
                <h2 id="case-title" class="cl-display">Not the obvious answer</h2>
                <blockquote class="cl-case-quote">
                    <p>"My espresso machine was due Friday. Tracking hasn't moved in a week, and it's your second late order. I want a refund."</p>
                    <footer>Maya Okafor, order LH-20417</footer>
                </blockquote>
                <p class="cl-lead">
                    It looks like a carrier delay, and she already had a goodwill credit for the last one. The specialists find something else.
                </p>
            </div>
            <div class="cl-case-fold">
                <details class="cl-case-more">
                    <summary class="cl-case-toggle">
                        <span class="cl-case-toggle-closed">See how the agent team worked it out</span>
                        <span class="cl-case-toggle-open">Hide how the agent team worked it out</span>
                        <span class="cl-case-chevron" aria-hidden="true"></span>
                    </summary>
                    <div class="cl-case-more-body">
                        <ol class="cl-case-steps">
                            <li>
                                <p class="cl-case-who"><span class="cl-case-name">customer</span> support desk database · 6.5 s · 2 tools</p>
                                <h3 class="cl-display">A Plus customer, late twice in 120 days</h3>
                                <p>LH-18802 arrived 3 days late on 2026-08-15, with a $10 goodwill credit. LH-20417 is late now.</p>
                            </li>
                            <li>
                                <p class="cl-case-who"><span class="cl-case-name">operations</span> warehouse and carrier scans · 4.8 s · 1 tool</p>
                                <h3 class="cl-display">The carrier never had the parcel</h3>
                                <p>
                                    It failed the outbound scale check in Columbus on 2026-09-29 and went to an exception cage. Four more orders from the same packing wave
                                    are held. Reno can reship by Express for Thursday.
                                </p>
                            </li>
                            <li>
                                <p class="cl-case-who"><span class="cl-case-name">policy</span> after operations · 9.6 s · 1 tool</p>
                                <h3 class="cl-display">Larkfield's fault, section 1.2</h3>
                                <p>
                                    So the goodwill limit does not apply. A second late delivery lifts Plus to the Premier remedy: a $55.80 credit, 20% of $279.00, and a
                                    call from the Customer Care Lead. Five held orders mean an operations incident.
                                </p>
                            </li>
                        </ol>
                        <div class="cl-case-answer">
                            <div class="cl-case-answer-copy">
                                <p class="cl-case-who"><span class="cl-case-name">Harness Prime</span> decision, reply, actions, evidence · 19.8 s in all, median 16.5 s over five runs</p>
                                <p>
                                    Refund the $9.95 shipping, reship by Express for Thursday, recall the held parcel, add a $55.80 store credit, have the Customer Care Lead
                                    call, and open an operations incident for the packing wave. Or a full refund, if Maya prefers. Every amount and section comes from a
                                    specialist's tools.
                                </p>
                                <a class="cl-link-arrow" href="/docs/how-to/customer-care-demo/">How the team is built <Icon name="right-arrow" /></a>
                            </div>
                            <div class="cl-shot cl-case-shot">
                                <Focus
                                    src={careAnswer}
                                    alt="The end of the answer to Maya. The reply explains a warehouse error and offers an Express reship arriving Thursday, October 8, or a refund, plus a store credit and a call from the Customer Care Lead. Actions lists the shipping refund, the Reno reship, the recall, the store credit, the Care Lead call and an operations incident for packing wave W-0929-B. Evidence has one line each for customer, operations and policy, and the source line names Service Recovery Policy sections 1.2, 2.1, 2.3, 2.5, 3.1, 3.2, 3.3 and 3.4."
                                    cx={0.5}
                                    cy={0.6}
                                    zoom={1.75}
                                    ratio={16 / 10}
                                    widths={[720, 1080]}
                                    sizes="(min-width: 60rem) 560px, 100vw"
                                />
                            </div>
                        </div>
                    </div>
                </details>
                <a class="cl-link-arrow cl-case-guide" href="/docs/how-to/harnesses/">Read how harnesses work <Icon name="right-arrow" /></a>
            </div>
        </section>

        <section id="agent-teams-that-power-your-apps" class="cl-section cl-split" aria-labelledby="agent-teams-title">
            <div>
                <p class="cl-kicker">How a team works</p>
                <h2 id="agent-teams-title" class="cl-display">Agent teams that power your apps</h2>
                <p class="cl-lead">Give your app a team instead of a single prompt. In Cuttlely, an agent team is called a harness.</p>
                <ol class="cl-steps">
                    <li><strong>Harness Prime splits each question.</strong> The lead agent reads the question, sends each part to the right specialist, and writes one answer.</li>
                    <li><strong>Specialists do the work.</strong> Each one can have its own model, tools, playbooks and data.</li>
                    <li><strong>The analyst brings the numbers.</strong> It queries real tables and hands back the actual numbers.</li>
                </ol>
                <a class="cl-link-arrow" href="/docs/how-to/harnesses/">Harnesses guide <Icon name="right-arrow" /></a>
            </div>
            <figure class="cl-shot">
                <ZoomableImage
                    src={analystChat}
                    alt="A harness canvas with its test chat open. The run card says Harness Prime sent work to analyst, and the answer shows a table of open tasks."
                    widths={[640, 960, 1440]}
                    sizes="(min-width: 68rem) 560px, 100vw"
                />
            </figure>
        </section>

        <section id="small-context-big-answers" class="cl-section" aria-labelledby="context-title">
            <div class="cl-center">
                <p class="cl-kicker">Keep prompts small</p>
                <h2 id="context-title" class="cl-display">Small context, big answers</h2>
                <p class="cl-lead">
                    Long chats, big tables and long rule books don't have to mean long prompts. Cuttlely gives each agent only what its job needs, keeps your data
                    where it lives, and shows you what every run used.
                </p>
            </div>
            <ul class="cl-contrasts">
                <li>
                    <h3 class="cl-display">Each specialist gets its own job</h3>
                    <p class="cl-pair">
                        <span class="cl-pair-label">Typical</span>
                        Every agent gets the whole chat history.
                    </p>
                    <p class="cl-pair cl-pair-cuttlely">
                        <span class="cl-pair-label">Cuttlely</span>
                        Harness Prime writes each specialist a task that stands on its own. The specialist gets that task and a short recap of the recent turns.
                    </p>
                </li>
                <li>
                    <h3 class="cl-display">Data stays in the database</h3>
                    <p class="cl-pair">
                        <span class="cl-pair-label">Typical</span>
                        Query results are pasted into the prompt.
                    </p>
                    <p class="cl-pair cl-pair-cuttlely">
                        <span class="cl-pair-label">Cuttlely</span>
                        The analyst runs the query and hands back one page of rows. Say "show more" and it fetches the next page. Earlier pages stay out of the
                        next prompt.
                    </p>
                </li>
                <li>
                    <h3 class="cl-display">Rules load when they're needed</h3>
                    <p class="cl-pair">
                        <span class="cl-pair-label">Typical</span>
                        Every instruction sits in one giant system prompt.
                    </p>
                    <p class="cl-pair cl-pair-cuttlely">
                        <span class="cl-pair-label">Cuttlely</span>
                        Put long rules in playbooks. A specialist sees each playbook's name and when to use it, and opens the full text only when a question needs it.
                    </p>
                </li>
                <li>
                    <h3 class="cl-display">Short handoffs</h3>
                    <p class="cl-pair">
                        <span class="cl-pair-label">Typical</span>
                        Whole documents are pasted into the prompt that writes the final answer.
                    </p>
                    <p class="cl-pair cl-pair-cuttlely">
                        <span class="cl-pair-label">Cuttlely</span>
                        Harness Prime reads a capped part of each specialist's answer, with the source names and a short snippet. The documents go back to your
                        app in the response.
                    </p>
                </li>
                <li>
                    <h3 class="cl-display">See every token</h3>
                    <p class="cl-pair">
                        <span class="cl-pair-label">Typical</span>
                        You find out what a run used on next month's bill.
                    </p>
                    <p class="cl-pair cl-pair-cuttlely">
                        <span class="cl-pair-label">Cuttlely</span>
                        The run card shows input and output tokens, cached tokens when the model reports them, and how long each step took. The API response
                        carries the same numbers. The Publish check shows Live and the draft side by side with the tokens and time each one used. If a prompt
                        had to be shortened, the run says so.
                    </p>
                </li>
            </ul>
            <p class="cl-center">
                <a class="cl-link-arrow" href="/docs/how-to/context-and-tokens/">How Cuttlely keeps context small <Icon name="right-arrow" /></a>
            </p>
        </section>

        <section id="use-a-team-from-your-app" class="cl-section" aria-labelledby="api-title">
            <div class="cl-center">
                <p class="cl-kicker">Call it from your app</p>
                <h2 id="api-title" class="cl-display">Use a team from your app</h2>
                <p class="cl-lead">
                    Your app sends the team a question through the API and gets back one researched answer, a chart or an action. Here is a real call to a small bakery team
                    with two specialists, <code>baker</code> and <code>orders</code>.
                </p>
            </div>
            <div class="cl-code-pair">
                <div>
                    <p class="cl-code-label">Request</p>
                    <Code code={curl} lang="bash" />
                </div>
                <div>
                    <p class="cl-code-label">Response</p>
                    <Code code={answer} lang="json" />
                </div>
            </div>
            <p class="cl-center cl-note">
                Harness Prime split the question: <code>baker</code> priced the order and <code>orders</code> checked the pickup day. The full response also has the tokens,
                the timings, the sources and any images the team made.
            </p>
            <p class="cl-center"><a class="cl-link-arrow" href="/docs/api/">API guide <Icon name="right-arrow" /></a></p>
        </section>

        <section id="tools-your-teams-use" class="cl-section" aria-labelledby="tools-title">
            <div class="cl-center">
                <p class="cl-kicker">Built in</p>
                <h2 id="tools-title" class="cl-display">Tools your teams use</h2>
                <p class="cl-lead">Knowledge pipelines, visual workflows and Build with AI give your teams what they need.</p>
            </div>
            <ul class="cl-tiles">
                {
                    tools.map((tool) => (
                        <li class="cl-tile">
                            <div class="cl-tile-media">
                                <video
                                    class="cl-tile-video"
                                    data-loop-video
                                    muted
                                    loop
                                    playsinline
                                    preload="none"
                                    width="960"
                                    height="540"
                                    poster={mediaUrl(`/media/products/${tool.video.slug}-poster.webp`)}
                                    aria-label={tool.video.label}
                                >
                                    <source src={mediaUrl(`/media/products/${tool.video.slug}-loop.webm`)} type="video/webm" />
                                    <source src={mediaUrl(`/media/products/${tool.video.slug}-loop.mp4`)} type="video/mp4" />
                                </video>
                                <button
                                    type="button"
                                    class="cl-play-overlay"
                                    data-play-with-sound
                                    data-video-dialog-open={`video-${tool.video.slug}`}
                                    aria-label={`Play ${tool.title} with sound`}
                                >
                                    <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true">
                                        <path d="M8 5v14l12-7z" fill="currentColor" />
                                    </svg>
                                </button>
                                <a class="cl-tile-play" href={mediaUrl(`/media/products/${tool.video.slug}.mp4`)} data-video-dialog-open={`video-${tool.video.slug}`}>
                                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="currentColor" /></svg>
                                    Watch with sound <span class="cl-tile-play-length">{tool.video.length}</span>
                                </a>
                                <dialog id={`video-${tool.video.slug}`} class="cl-video-dialog" aria-label={`${tool.title}: narrated video with captions`}>
                                    <video controls playsinline preload="none" width="1280" height="720" poster={mediaUrl(`/media/products/${tool.video.slug}-poster.webp`)}>
                                        <source src={mediaUrl(`/media/products/${tool.video.slug}.mp4`)} type="video/mp4" />
                                    </video>
                                    <form method="dialog">
                                        <button class="cl-video-close" aria-label="Close">×</button>
                                    </form>
                                </dialog>
                            </div>
                            <a class="cl-tile-link" href={tool.href}>
                                <span class="cl-tile-body">
                                    <span class="cl-tile-title cl-display">{tool.title}</span>
                                    <span class="cl-tile-text">{tool.text}</span>
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section id="ship-changes-safely-draft-compare-publish-roll-back" class="cl-section cl-split cl-split-reverse" aria-labelledby="ship-title">
            <div>
                <p class="cl-kicker">Ship changes safely</p>
                <h2 id="ship-title" class="cl-display">Draft, compare, publish, roll back</h2>
                <p class="cl-lead">Changing an AI app that people already use should not mean testing on them. Cuttlely treats every change as a release.</p>
                <ul class="cl-checks">
                    <li><strong>Drafts never touch Live.</strong> The API, embeds and shared links keep serving Live until you publish.</li>
                    <li><strong>Compare before you publish.</strong> Ask recent real questions again on Live and on your draft, and see both answers side by side.</li>
                    <li><strong>Every version is kept.</strong> Open an old version as your draft, or roll Live back to it, in one step.</li>
                    <li><strong>Promote from Dev to Prod.</strong> Prod shows what would change and goes Live only when its owner says so.</li>
                </ul>
                <a class="cl-link-arrow" href="/docs/how-to/versioning/">Version history guide <Icon name="right-arrow" /></a>
            </div>
            <figure class="cl-shot">
                <Focus
                    src={publishCheck}
                    alt="The Publish dialog for a bakery chatflow after a check: each recent question shows the Live answer and the draft answer side by side with their tokens and time."
                    cx={0.5}
                    cy={0.42}
                    zoom={1.45}
                    ratio={4 / 3}
                    widths={[960, 1440]}
                    sizes="(min-width: 68rem) 820px, 145vw"
                />
            </figure>
        </section>

        <section id="run-it-your-way" class="cl-section" aria-labelledby="run-title">
            <div class="cl-center">
                <p class="cl-kicker">Run it your way</p>
                <h2 id="run-title" class="cl-display">On your laptop, your server or Render</h2>
                <p class="cl-lead">Change sign-in, the database, storage and more from <strong>Admin</strong>. People sign in with a password or WorkOS AuthKit.</p>
            </div>
            <ul class="cl-installs">
                {
                    installs.map((item) => (
                        <li>
                            <a href={item.href}>
                                <Icon name={item.icon} size="1.5rem" />
                                <span class="cl-display">{item.title}</span>
                                <span>{item.text}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
            <figure class="cl-shot cl-shot-wide">
                <ZoomableImage
                    src={serverSettings}
                    alt="Admin, Server settings, All settings: every setting with its section, where its value comes from, and its value."
                    widths={[720, 1080, 1440]}
                    sizes="(min-width: 68rem) 1000px, 100vw"
                />
            </figure>
            <p class="cl-center cl-note">
                Cuttlely does not report usage, check for updates or load fonts, scripts or images from other sites. <a href="/security/#what-cuttlely-connects-to"
                    >What Cuttlely connects to</a
                >
            </p>
        </section>

        <section id="bring-your-existing-flows" class="cl-section cl-band" aria-labelledby="bring-title">
            <h2 id="bring-title" class="cl-display">Bring your existing flows</h2>
            <p>Have flows from another tool? The <strong>Import</strong> menu checks an export and opens it on the right canvas.</p>
            <a class="cl-link-arrow" href="/docs/bring-your-flows/">What carries over <Icon name="right-arrow" /></a>
        </section>

        <section class="cl-final" aria-labelledby="final-title">
            <Image src={laptop} alt="" widths={[200, 400]} sizes="200px" class="cl-final-mascot" />
