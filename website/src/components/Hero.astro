---
// The home page hero: kicker, headline, supporting line, the two main actions, the one-command start and the mascot.
// Starlight renders this component only for pages with `hero` in their frontmatter (the home page).
import { Image } from 'astro:assets'
import mascot from '../assets/cuttlely-mascot-primary-1024.webp'
import { Icon } from '@astrojs/starlight/components'
import CopyButton from './CopyButton.astro'
import { REPO_URL } from '../../scripts/site-config.mjs'

const hero = Astro.locals.starlightRoute.entry.data.hero ?? {}
const tagline = hero.tagline ?? ''
---

<section class="cl-hero not-content" aria-labelledby="_top">
    <div class="cl-hero-copy">
        {tagline && (
            <p class="cl-eyebrow">
                <span class="cl-dot" aria-hidden="true"></span>
                {tagline}
            </p>
        )}
        <h1 id="_top" class="cl-display cl-hero-title">Your applications <span class="cl-gradient-text">deserve agents</span></h1>
        <p class="cl-hero-lead">Orchestrate AI agent teams that are lean by design, so each agent sees only what it needs. See what each run uses and costs, and replay real questions before you publish.</p>
        <div class="cl-actions">
            <a class="cl-button cl-button-primary" href="/quickstart/?ref=home-hero">
                Get started in 10 minutes
                <Icon name="right-arrow" size="1.1em" />
            </a>
            <a class="cl-button cl-button-ghost" href={`${REPO_URL}?ref=home-hero`}>
                <Icon name="github" size="1.1em" />
                Star on GitHub
            </a>
        </div>
        <div class="cl-hero-start" role="group" aria-label="Start Cuttlely with one command">
            <div class="cl-terminal cl-terminal-inline">
                <pre id="cl-hero-npx"><code><span class="cl-prompt" aria-hidden="true">$ </span>npx cuttlely start</code></pre>
                <CopyButton target="cl-hero-npx" label="Copy the command npx cuttlely start" />
            </div>
            <p class="cl-hero-start-note">Node 20+ and Docker · <a href="/quickstart/?ref=home-hero#docker-not-running">Docker not running?</a> · <a href={`${REPO_URL}?ref=home-hero`}>github.com/cuttlely/cuttlely</a></p>
        </div>
        <p class="cl-hero-from">
            <span id="bring-your-existing-flows" class="cl-anchor" aria-hidden="true"></span>
            <a class="cl-link-arrow" href="/flowise/">Already have flows? Bring them over <Icon name="right-arrow" /></a>
        </p>
        <p class="cl-hero-from">
            1.4.5 is out. If you're on 1.4.4, upgrade: the PostgreSQL MCP read-only check now accepts read-only helper functions written as string-body SQL or PL/pgSQL, such as the date and number parsing helpers views call, without an Allowed functions entry. Functions that write are still refused. <a href="/changelog/">What's new</a> · <a href="https://github.com/cuttlely/cuttlely/security/advisories">Security advisories</a>
        </p>
    </div>
    <div class="cl-hero-art" aria-hidden="true">
        <div class="cl-orb"></div>
        <Image src={mascot} alt="" widths={[320, 480, 640]} sizes="(min-width: 64rem) 320px, 240px" loading="eager" fetchpriority="high" class="cl-mascot" />
    </div>
</section>
