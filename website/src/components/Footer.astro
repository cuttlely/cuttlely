---
// Starlight's page footer (edit link, previous and next), then the site footer.
import Default from '@astrojs/starlight/components/Footer.astro'
import SiteFooter from './SiteFooter.astro'
---

<Default />
<SiteFooter />
<script>
    import { initScreenshotViewer } from '../scripts/screenshot-viewer.mjs'
    import { initDemoVideo, initVideoDialogs } from '../scripts/demo-video.mjs'
    initScreenshotViewer()
    // The home page videos. Pages without them skip this.
    initDemoVideo()
    initVideoDialogs()
</script>
