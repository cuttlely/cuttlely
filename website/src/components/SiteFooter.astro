---
import { REPO_URL } from '../../scripts/site-config.mjs'
const year = 2026
---

<footer class="cl-site-footer not-content">
    <div class="cl-site-footer-inner">
        <a href="/" class="cl-footer-brand" aria-label="Cuttlely home">
            <img src="/logo/cuttlely-mark.svg" alt="" width="28" height="28" />
            <span>
                <strong>Cuttlely</strong>
                <small>The visual agent builder, ready for production.</small>
            </span>
        </a>
        <nav aria-label="Footer">
            <a href="/docs/">Docs</a>
            <a href="/quickstart/">Quickstart</a>
            <a href="/changelog/">Changelog</a>
            <a href="/faq/">FAQ</a>
            <a href="/security/">Security</a>
            <a href="/credits/">Credits</a>
            <a href={`${REPO_URL}/blob/main/LICENSE.md`}>License</a>
            <a href={REPO_URL}>GitHub</a>
            <a href="mailto:info@cuttlely.com">info@cuttlely.com</a>
        </nav>
        <p class="cl-copyright">Copyright {year} The Cuttlely Authors. Apache License 2.0. Includes open-source code from other projects, see <a href="/credits/">Credits</a>.</p>
    </div>
</footer>
