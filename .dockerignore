# History is not needed in the image.
.git

node_modules
dist
build

**/node_modules
**/build
**/dist

# Local task and tool caches. They are not source.
# .turbo has to stay out of the context: the image build runs turbo, a cache hit
# restores only the outputs listed in turbo.json, and the UI writes build/.
.turbo
**/.turbo
.cache
**/.cache
.eslintcache
**/.eslintcache
**/*.tsbuildinfo
.pnpm-store
.verify
**/coverage
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

packages/server/.env
packages/ui/.env

.cuttlely
hermes/.venv
**/.venv

# A local .env must not be copied into the image. .env.example has no secrets.
.env
.env.*
!.env.example

# Contributor project notes are not needed at run time.
.projects

# The cuttlely.com website is not part of the product image.
website

# Docs screenshot capture is a local tool, not part of the product image or the npm packages.
scripts/docs-shots
